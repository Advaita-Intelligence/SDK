# Acai Ingest Server — Environment Variables

# Port to listen on
PORT=3000

# Default project API key (used to validate SDK requests)
# Generate a secure random key: openssl rand -hex 32
ACAI_API_KEY=acai_dev_key_replace_me

# Enable admin debug routes (GET /admin/events)
# Set to "true" only in development — NEVER in production
ADMIN_ENABLED=false

# Secret key required for admin routes (x-admin-key header)
ADMIN_SECRET=change_me_to_something_secret
